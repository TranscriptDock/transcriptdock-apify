{
  "actorSpecification": 1,
  "name": "transcriptdock-video-transcripts",
  "title": "Transcript Dock Video Transcripts",
  "description": "Timed video transcripts through the Transcript Dock API. Bring your own API key.",
  "version": "0.1",
  "dockerfile": "../Dockerfile",
  "input": "./input_schema.json",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "Transcript results",
    "properties": {
      "results": {
        "title": "Video transcripts",
        "description": "One result per unique video link, including job status, billing and the full transcript when available.",
        "template": "{{links.apiDefaultDatasetUrl}}/items",
        "type": "string"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {
        "type": "object",
        "required": [
          "url",
          "jobId",
          "status",
          "timedOut",
          "billing"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "timedOut": {
            "type": "boolean"
          },
          "billing": {
            "type": "object"
          },
          "transcript": {
            "type": "object"
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "views": {
        "results": {
          "title": "Transcripts",
          "transformation": {
            "fields": [
              "url",
              "jobId",
              "status",
              "timedOut",
              "billing",
              "transcript",
              "error"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
